<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.licenseguard.frontend.controller.ReportsController" style="-fx-background-color: transparent;">
    <VBox spacing="20">
        <!-- Top Summary Cards -->
        <HBox spacing="15">
            <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-blue">
                <Text text="TOTAL SEAT CAPACITY" styleClass="kpi-title"/>
                <Label fx:id="lblTotalCapacity" text="0" styleClass="kpi-value"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-green">
                <Text text="ASSIGNED SEATS IN USE" styleClass="kpi-title"/>
                <Label fx:id="lblAssignedSeats" text="0" styleClass="kpi-value" style="-fx-fill: #A6E3A1;"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-amber">
                <Text text="UNASSIGNED / AVAILABLE" styleClass="kpi-title"/>
                <Label fx:id="lblUnassignedSeats" text="0" styleClass="kpi-value" style="-fx-fill: #F9E2AF;"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card, kpi-red">
                <Text text="SEAT UTILIZATION RATE" styleClass="kpi-title"/>
                <Label fx:id="lblUtilizationRate" text="0%" styleClass="kpi-value" style="-fx-fill: #89B4FA;"/>
            </VBox>
        </HBox>

        <!-- Detailed Audit Tables -->
        <VBox spacing="10" styleClass="kpi-card">
            <HBox alignment="CENTER_LEFT">
                <Text text="Software License Utilization Summary" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #89B4FA;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="↻ Refresh Audit Data" onAction="#loadData" styleClass="btn-secondary"/>
            </HBox>
            <TableView fx:id="softwareSummaryTable" prefHeight="240">
                <columns>
                    <TableColumn fx:id="colSoftwareName" text="Software Name" prefWidth="200"/>
                    <TableColumn fx:id="colVendorName" text="Vendor" prefWidth="160"/>
                    <TableColumn fx:id="colTotalLicenses" text="Total Licenses" prefWidth="120"/>
                    <TableColumn fx:id="colTotalSeats" text="Total Seats" prefWidth="110"/>
                    <TableColumn fx:id="colAvailableSeats" text="Available Seats" prefWidth="120"/>
                    <TableColumn fx:id="colAssignedCount" text="Active Assignments" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Expiring Licenses Alert Table -->
        <VBox spacing="10" styleClass="kpi-card, kpi-amber">
            <Text text="Expiring Licenses Alert (Next 30 Days)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #F9E2AF;"/>
            <TableView fx:id="expiringLicensesTable" prefHeight="200">
                <columns>
                    <TableColumn fx:id="colExpSoftware" text="Software" prefWidth="180"/>
                    <TableColumn fx:id="colExpKey" text="License Key" prefWidth="200"/>
                    <TableColumn fx:id="colExpExpiry" text="Expiry Date" prefWidth="120"/>
                    <TableColumn fx:id="colExpAvailable" text="Available Seats" prefWidth="120"/>
                    <TableColumn fx:id="colExpStatus" text="Status" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>

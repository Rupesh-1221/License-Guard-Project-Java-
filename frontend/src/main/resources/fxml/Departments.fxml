<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="15" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.licenseguard.frontend.controller.DepartmentController">
    <!-- Action Bar -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="🔍 Search departments..." prefWidth="375"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↻ Refresh" onAction="#loadData" styleClass="btn-secondary"/>
        <Button text="+ Add Department" onAction="#handleAdd" styleClass="btn-primary"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="departmentTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="90"/>
            <TableColumn fx:id="colName" text="Department Name" prefWidth="300"/>
            <TableColumn fx:id="colDescription" text="Description" prefWidth="480"/>
            <TableColumn fx:id="colUserCount" text="Users" prefWidth="150"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="240"/>
        </columns>
    </TableView>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="15" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.licenseguard.frontend.controller.SoftwareController">
    <!-- Action Bar -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="🔍 Search software..." prefWidth="375"/>
        <ComboBox fx:id="vendorFilter" promptText="Filter by Vendor" prefWidth="270"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↻ Refresh" onAction="#loadData" styleClass="btn-secondary"/>
        <Button text="+ Add Software" onAction="#handleAdd" styleClass="btn-primary"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="softwareTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="90"/>
            <TableColumn fx:id="colName" text="Software Name" prefWidth="270"/>
            <TableColumn fx:id="colVersion" text="Version" prefWidth="135"/>
            <TableColumn fx:id="colVendor" text="Vendor" prefWidth="240"/>
            <TableColumn fx:id="colDescription" text="Description" prefWidth="375"/>
            <TableColumn fx:id="colLicenseCount" text="Licenses" prefWidth="135"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="240"/>
        </columns>
    </TableView>
</VBox>

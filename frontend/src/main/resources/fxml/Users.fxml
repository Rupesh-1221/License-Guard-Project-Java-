<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="15" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.licenseguard.frontend.controller.UserController">
    <!-- Action Bar -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="🔍 Search users..." prefWidth="250"/>
        <ComboBox fx:id="departmentFilter" promptText="Filter by Department" prefWidth="180"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↻ Refresh" onAction="#loadData" styleClass="btn-secondary"/>
        <Button text="+ Add User" onAction="#handleAdd" styleClass="btn-primary"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colName" text="Full Name" prefWidth="180"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colRole" text="Role" prefWidth="100"/>
            <TableColumn fx:id="colDepartment" text="Department" prefWidth="150"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="160"/>
        </columns>
    </TableView>
</VBox>
